# Exclude unnecessary files from the Docker build context.
# The Dockerfile performs a `git clone` of the upstream repo inside the build,
# so the local workspace only needs to supply nginx.conf and nothing else.

# ── Version control ──────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── CI/CD ────────────────────────────────────────────────────────────────────
.github/

# ── Documentation ────────────────────────────────────────────────────────────
*.md
LICENSE
SECURITY.md

# ── Dependency directories ───────────────────────────────────────────────────
node_modules/
vendor/
.venv/
__pycache__/

# ── Build artifacts ──────────────────────────────────────────────────────────
dist/
build/
*.tar
*.tar.gz
*.zip

# ── Development / editor files ───────────────────────────────────────────────
*.log
*.tmp
*.swp
*.swo
.DS_Store
.env
.env.*
*.env

# ── Secrets / credentials ────────────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12

# ── Scan artifacts ───────────────────────────────────────────────────────────
image-scan.tar
build-manifest-*.json
